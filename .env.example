# Agent Sandbox environment variables.
# Copy to .env and fill in real values. Each key has one name.

# Required for Express: sandbox API key
ABX_SANDBOX_API_KEY=your_api_key_here

# Optional: platform URL and data-plane domain
# ABX_SANDBOX_BASE_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
# ABX_SANDBOX_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com

# Optional: provider (default alicloud-express)
# ABX_PROVIDER=alicloud-express

# Container Edition: specify the cluster manager key and a domain or management URL.
# ABX_ALICLOUD_CONTAINER_API_KEY=
# ABX_ALICLOUD_CONTAINER_DOMAIN=sandbox.example.com
# ABX_ALICLOUD_CONTAINER_BASE_URL=https://sandbox.example.com/kruise/api
# ABX_ALICLOUD_CONTAINER_PROTOCOL=private

# Optional: Alibaba Cloud official names
# ALIBABA_CLOUD_REGION_ID=cn-hangzhou
# ALICLOUD_ACCESS_KEY_ID=your_ak
# ALICLOUD_ACCESS_KEY_SECRET=your_sk

# Optional: GitHub token for template downloads
# GITHUB_TOKEN=ghp_your_token_here

# Optional: LLM key for template generation
# ABX_LLM_API_KEY=your_llm_key

# ACR
# ACR_NAMESPACE=<your-namespace>
# ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# ACR_REPO=
# ACR_USERNAME=
# ACR_PASSWORD=
# ACREE_INSTANCE_ID=

# Optional STS SecurityToken, paired with temporary ALICLOUD_ACCESS_KEY_ID/SECRET.
# ALIBABA_CLOUD_SECURITY_TOKEN=REPLACE_ME
