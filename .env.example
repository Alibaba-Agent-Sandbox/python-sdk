# Easy Sandbox environment variables.
# Copy to .env and fill in real values. Each key has one name.

# Required: sandbox API key
EBX_SANDBOX_API_KEY=your_api_key_here

# Optional: platform URL and data-plane domain
# EBX_SANDBOX_BASE_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
# EBX_SANDBOX_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com

# Optional: provider (default alicloud-express)
# EBX_PROVIDER=alicloud-express

# Optional: Alibaba Cloud official names
# ALIBABA_CLOUD_REGION_ID=cn-hangzhou
# ALICLOUD_ACCESS_KEY_ID=your_ak
# ALICLOUD_ACCESS_KEY_SECRET=your_sk

# Optional: GitHub token for template downloads
# GITHUB_TOKEN=ghp_your_token_here

# Optional: LLM key for template generation
# EBX_LLM_API_KEY=your_llm_key

# ACR
# ACR_NAMESPACE=<your-namespace>
# ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# ACR_REPO=
# ACR_USERNAME=
# ACR_PASSWORD=
# ACREE_INSTANCE_ID=
