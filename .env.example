# Easy Sandbox SDK 环境变量
# 复制此文件为 .env 并填入真实值

# 必须：API Key。规范名称为 EBX_SANDBOX_API_KEY；E2B_API_KEY 是长期兼容的别名，两者等价
# （同一层内规范名称优先；见 docs/en/reference/configuration.md）
E2B_API_KEY=e2b_your_api_key_here
# EBX_SANDBOX_API_KEY=e2b_your_api_key_here

# 可选：API 地域配置
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com

# 可选：GitHub Token（用于模板下载；GITHUB_TOKEN 同样有效，EBX_GITHUB_TOKEN 优先）
# EBX_GITHUB_TOKEN=ghp_your_token_here

# 可选：沙箱提供方（默认 alicloud-express，阿里云极速版）
# EBX_PROVIDER=alicloud-express
# EBX_ALICLOUD_EXPRESS_REGION=cn-hangzhou

# 可选：阿里云 AK/SK（用于控制面 API；规范名称 EBX_ALICLOUD_EXPRESS_ACCESS_KEY_ID/_SECRET）
# ALICLOUD_ACCESS_KEY_ID=your_ak
# ALICLOUD_ACCESS_KEY_SECRET=your_sk

# --- ACR (Container Registry) Configuration ---
# ACR_NAMESPACE is resolved from: CLI flag > os.environ > .env file
ACR_NAMESPACE=<your-namespace>
# The following must be set as real environment variables (export), not just in .env:
# ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# ACR_REPO=
# ACR_USERNAME=
# ACR_PASSWORD=
# ACREE_INSTANCE_ID=
