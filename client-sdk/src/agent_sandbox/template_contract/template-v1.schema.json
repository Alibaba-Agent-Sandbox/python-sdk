{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Alibaba-Agent-Sandbox/awesome-templates/main/spec/template-v1.schema.json",
  "title": "Agent Sandbox template v1 intent contract (not enabled in active consumers)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}(?![\\s\\S])"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/$defs/source"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "props": {
              "type": "object"
            }
          },
          "oneOf": [
            {
              "required": [
                "source"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "image"
                    ]
                  },
                  {
                    "required": [
                      "reference"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "image"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "reference"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "reference"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "image"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "instance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "$ref": "#/$defs/positiveIntegerInput"
            },
            "envs": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cpu": {
              "$ref": "#/$defs/positiveIntegerInput"
            },
            "memory": {
              "$ref": "#/$defs/positiveIntegerInput"
            },
            "disk": {
              "$ref": "#/$defs/nonnegativeIntegerInput"
            },
            "gpu": {
              "type": "string",
              "minLength": 1
            },
            "secure": {
              "$ref": "#/$defs/booleanInput"
            },
            "volume_mounts": {
              "type": "object",
              "propertyNames": {
                "pattern": "^/(?!bin(?:/|$)|opt(?:/|$)|var(?:/|$)|dev(?:/|$))(?!.*(?:^|/)\\.)(?!.*//)[^\\x00]+[^/]$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "onTimeout": {
                  "enum": [
                    "pause",
                    "kill"
                  ]
                },
                "autoResume": {
                  "$ref": "#/$defs/booleanInput"
                }
              },
              "required": [
                "onTimeout"
              ]
            },
            "provider_options": {
              "type": "object"
            }
          }
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/service"
          }
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "required": [
        "template"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "alicloud-express"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "instance": {
                "$ref": "#/$defs/instance_alicloud-express"
              },
              "template": {
                "properties": {
                  "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      },
                      "memory": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "opensandbox"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "instance": {
                "$ref": "#/$defs/instance_opensandbox"
              },
              "template": {
                "properties": {
                  "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      },
                      "memory": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "e2b"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "instance": {
                "$ref": "#/$defs/instance_e2b"
              },
              "template": {
                "properties": {
                  "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      },
                      "memory": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "cubesandbox"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "instance": {
                "$ref": "#/$defs/instance_cubesandbox"
              },
              "template": {
                "properties": {
                  "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      },
                      "memory": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "alicloud-container"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "instance": {
                "$ref": "#/$defs/instance_alicloud-container"
              },
              "template": {
                "properties": {
                  "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      },
                      "memory": {
                        "$ref": "#/$defs/positiveIntegerInput"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edition": {
          "const": "3.0.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "vars": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "props": {
                "$ref": "#/$defs/componentProps"
              },
              "actions": {}
            },
            "required": [
              "component",
              "props"
            ]
          }
        },
        "flow": {
          "type": "object"
        },
        "actions": {},
        "template": {
          "type": "object"
        },
        "validation": {
          "type": "boolean"
        }
      },
      "required": [
        "edition",
        "resources"
      ],
      "description": "Embedded native Serverless Devs 3 project. Native project semantics and component properties are validated by the actual selected Devs implementation, not this envelope schema."
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "agents-api"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gateway": {
              "type": "string",
              "minLength": 1
            },
            "worker": {
              "type": "string",
              "minLength": 1
            },
            "dispatcher": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "gateway",
            "worker",
            "dispatcher"
          ]
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/$defs/recipe"
            },
            "image": {
              "type": "string",
              "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "source"
              ],
              "not": {
                "required": [
                  "image"
                ]
              }
            },
            {
              "required": [
                "image"
              ],
              "not": {
                "required": [
                  "source"
                ]
              }
            }
          ]
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idleTimeoutSeconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxLogicalSessionsPerOwner": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxActiveSessions": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxQueuedTurnsPerSession": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "resultRetentionSeconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFileBytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxArtifactBytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxTurnArtifactBytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxRetainedBytesPerOwner": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRunSeconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxToolSeconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxConcurrentRuns": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxQueuedRuns": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxRunsPerMinute": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxEventsPerRun": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 5
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxOutputBytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1024
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "maxSubscribersPerSession": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databaseUrl": {
              "$ref": "#/$defs/secret"
            },
            "vpcConfig": {
              "type": "object"
            },
            "databaseCa": {
              "$ref": "#/$defs/secret"
            }
          },
          "required": [
            "databaseUrl"
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sandboxAccess": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apiKey": {
                  "$ref": "#/$defs/secret"
                },
                "baseUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "region": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "apiKey",
                "baseUrl",
                "domain",
                "region"
              ]
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apiKey": {
                  "$ref": "#/$defs/secret"
                },
                "baseUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "adapter": {
                  "enum": [
                    "codex",
                    "qwen-code"
                  ]
                }
              },
              "required": [
                "apiKey",
                "baseUrl",
                "model",
                "adapter"
              ]
            },
            "clientAuth": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "generate": {
                      "const": true,
                      "default": true
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "generate"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "owner": {
                            "type": "string",
                            "minLength": 1
                          },
                          "scopes": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "agents:read",
                                "agents:write"
                              ]
                            }
                          },
                          "expiresAt": {
                            "$ref": "#/$defs/positiveIntegerInput"
                          }
                        },
                        "required": [
                          "sha256",
                          "owner",
                          "scopes"
                        ]
                      }
                    }
                  },
                  "required": [
                    "tokens"
                  ]
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "internalAuth": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "generate": {
                      "const": true,
                      "default": true
                    },
                    "roleArn": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "generate"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "token": {
                      "$ref": "#/$defs/secret"
                    },
                    "roleArn": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "token"
                  ]
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "function-alias",
                    "custom-domain"
                  ]
                },
                "aliasName": {
                  "type": "string",
                  "minLength": 1
                },
                "allowTestDomain": {
                  "type": "boolean"
                },
                "domainName": {
                  "type": "string",
                  "minLength": 1
                },
                "protocol": {
                  "const": "HTTPS"
                },
                "path": {
                  "const": "/"
                }
              },
              "required": [
                "kind"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "function-alias"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "allowTestDomain"
                    ],
                    "properties": {
                      "allowTestDomain": {
                        "const": true
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "domainName"
                          ]
                        },
                        {
                          "required": [
                            "protocol"
                          ]
                        },
                        {
                          "required": [
                            "path"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "custom-domain"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "domainName",
                      "protocol"
                    ],
                    "not": {
                      "required": [
                        "allowTestDomain"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "sandboxAccess",
            "model",
            "ingress"
          ]
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeApply": {
              "$ref": "#/$defs/hooks"
            },
            "afterReady": {
              "$ref": "#/$defs/hooks"
            }
          },
          "required": []
        }
      },
      "required": [
        "type",
        "roles",
        "server",
        "state",
        "bindings"
      ]
    }
  },
  "required": [
    "specVersion",
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "sandbox"
      ]
    },
    {
      "required": [
        "deployment"
      ]
    }
  ],
  "dependentRequired": {
    "application": [
      "sandbox",
      "deployment"
    ]
  },
  "$defs": {
    "expression": {
      "type": "string",
      "pattern": "^\\$\\{[\\s\\S]+\\}$",
      "description": "A native Serverless Devs expression; only the official parser evaluates it."
    },
    "positiveIntegerInput": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "nonnegativeIntegerInput": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "booleanInput": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "secret": {
      "type": "string",
      "pattern": "^\\$\\{[\\s\\S]+\\}$",
      "description": "A native Serverless Devs expression; only the official parser evaluates it."
    },
    "componentProps": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "default": "Dockerfile"
        },
        "context": {
          "const": ".",
          "default": "."
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dockerfile": {
                "type": "string",
                "minLength": 1,
                "default": "Dockerfile"
              },
              "context": {
                "const": ".",
                "default": "."
              }
            }
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "default": "Dockerfile"
        },
        "context": {
          "const": ".",
          "default": "."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "required": [
        "protocol",
        "version",
        "port"
      ]
    },
    "openSandboxOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "ready_timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "network_policy": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64",
            "windows/amd64",
            "windows/arm64"
          ]
        },
        "secure_access": {
          "$ref": "#/$defs/booleanInput"
        }
      }
    },
    "instance_alicloud-express": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cpu": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "memory": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "disk": {
          "$ref": "#/$defs/nonnegativeIntegerInput"
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "volume_mounts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^/(?!bin(?:/|$)|opt(?:/|$)|var(?:/|$)|dev(?:/|$))(?!.*(?:^|/)\\.)(?!.*//)[^\\x00]+[^/]$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "onTimeout": {
              "enum": [
                "pause",
                "kill"
              ]
            },
            "autoResume": {
              "$ref": "#/$defs/booleanInput"
            }
          },
          "required": [
            "onTimeout"
          ]
        }
      }
    },
    "instance_opensandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cpu": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "memory": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "secure": {
          "$ref": "#/$defs/booleanInput"
        },
        "provider_options": {
          "$ref": "#/$defs/openSandboxOptions"
        }
      }
    },
    "instance_e2b": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "instance_cubesandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "instance_alicloud-container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/positiveIntegerInput"
        },
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "refName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00-\\x1f]+$"
    },
    "hooks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/refName"
              },
              "type": {
                "const": "custom"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "cwd": {
                "$ref": "#/$defs/relativePath"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 900
              },
              "envAllowlist": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
                }
              }
            },
            "required": [
              "id",
              "type",
              "argv",
              "cwd",
              "timeoutSeconds",
              "envAllowlist"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/refName"
              },
              "type": {
                "const": "serverless-devs"
              },
              "step": {
                "enum": [
                  "gateway",
                  "worker",
                  "dispatcher"
                ]
              },
              "command": {
                "const": "info"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 900
              }
            },
            "required": [
              "id",
              "type",
              "step",
              "command",
              "timeoutSeconds"
            ]
          }
        ]
      }
    }
  }
}
