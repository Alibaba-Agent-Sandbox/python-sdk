{
  "version": 1,
  "valid": [
    {
      "id": "core-string-values",
      "text": "on: on\noff: OFF\ndate: 2026-11-12\nunderscores: 1_000\nbinary: 0b101\nhexUnderscores: 0x1_f\nsexagesimal: 1:20\n",
      "expected": {
        "on": "on",
        "off": "OFF",
        "date": "2026-11-12",
        "underscores": "1_000",
        "binary": "0b101",
        "hexUnderscores": "0x1_f",
        "sexagesimal": "1:20"
      }
    },
    {
      "id": "core-numeric-values",
      "text": "octal: 0o12\nhex: 0x12\nleadingZero: 010\nexponent: 1e2\ndecimal: 1.5\ninteger: 42\n",
      "expected": {
        "octal": 10,
        "hex": 18,
        "leadingZero": 10,
        "exponent": 100,
        "decimal": 1.5,
        "integer": 42
      }
    },
    {
      "id": "core-bool-null",
      "text": "truth: TRUE\nfalsity: false\nempty: null\ntilde: ~\nimplicit:\n",
      "expected": {
        "truth": true,
        "falsity": false,
        "empty": null,
        "tilde": null,
        "implicit": null
      }
    },
    {
      "id": "quoted-values",
      "text": "values: [\"true\", \"42\", \"2026-11-12\", \"null\"]\n",
      "expected": {
        "values": [
          "true",
          "42",
          "2026-11-12",
          "null"
        ]
      }
    },
    {
      "id": "yaml12-directive",
      "text": "%YAML 1.2\n---\nvalue: on\n",
      "expected": {
        "value": "on"
      }
    },
    {
      "id": "multiline-unicode-native-expressions",
      "text": "text: |\n  hello 中文\n  second line\nnative: \"${env('MODEL_KEY')}\"\n",
      "expected": {
        "text": "hello 中文\nsecond line\n",
        "native": "${env('MODEL_KEY')}"
      }
    },
    {
      "id": "literal-merge-key",
      "text": "<<: {a: plain}\n",
      "expected": {
        "<<": {
          "a": "plain"
        }
      }
    },
    {
      "id": "unused-anchor",
      "text": "value: &unused on\n",
      "expected": {
        "value": "on"
      }
    },
    {
      "id": "explicit-core-tags",
      "text": "int: !!int 12\nfloat: !!float 1.0\nbool: !!bool true\n\"null\": !!null null\nstring: !!str true\n",
      "expected": {
        "int": 12,
        "float": 1,
        "bool": true,
        "null": null,
        "string": "true"
      }
    },
    {
      "id": "json-subset",
      "text": "{\"on\":\"on\",\"date\":\"2026-11-12\",\"items\":[1,true,null]}",
      "expected": {
        "on": "on",
        "date": "2026-11-12",
        "items": [
          1,
          true,
          null
        ]
      }
    },
    {
      "id": "utf8-bom",
      "text": "﻿value: on\r\n",
      "expected": {
        "value": "on"
      }
    },
    {
      "id": "template-env-scalars",
      "text": "specVersion: 1\nname: example\nsandbox:\n  template: {reference: native-id}\n  instance:\n    envs: {FLAG: on, WHEN: 2026-11-12}\n",
      "expected": {
        "specVersion": 1,
        "name": "example",
        "sandbox": {
          "template": {
            "reference": "native-id"
          },
          "instance": {
            "envs": {
              "FLAG": "on",
              "WHEN": "2026-11-12"
            }
          }
        }
      }
    },
    {
      "id": "empty-document",
      "text": "",
      "expected": null
    }
  ],
