{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identity",
    "profile",
    "profile_digest",
    "checks",
    "cleanup_verified",
    "executed_at",
    "provenance"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_source_digest",
        "manifest_digest",
        "build_digest",
        "artifact_digest",
        "provider_digest",
        "consumer_version",
        "workflow_id",
        "binding_digest",
        "contract_digest"
      ],
      "properties": {
        "template_source_digest": {
          "type": "string",
          "minLength": 1
        },
        "manifest_digest": {
          "type": "string",
          "minLength": 1
        },
        "build_digest": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "minLength": 1
        },
        "provider_digest": {
          "type": "string",
          "minLength": 1
        },
        "consumer_version": {
          "type": "string",
          "minLength": 1
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_digest": {
          "type": "string",
          "minLength": 1
        },
        "contract_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "enum": [
        "application-cli",
        "application-python",
        "exec-cli",
        "interpreter-context"
      ]
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          }
        }
      }
    },
    "cleanup_verified": {
      "type": "boolean"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "runner",
        "revision",
        "artifact_digest",
        "run_id"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
