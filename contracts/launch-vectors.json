          },
          "start_cmd": "python app.py"
        },
        "provider": {
          "id": "fixture",
          "operation_contract_version": 1,
          "operations": {
            "cli": [
              "sandbox.create",
              "sandbox.delete",
              "template.prepare",
              "exec.run",
              "ports.resolve"
            ],
            "python": [
              "sandbox.create",
              "sandbox.delete",
              "exec.run",
              "ports.resolve"
